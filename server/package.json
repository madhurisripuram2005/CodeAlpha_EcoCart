{
  "name": "ecocart-server",
  "version": "1.0.0",
  "description": "Backend API for EcoCart - Smart Sustainable Shopping Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --no-warnings --experimental-sqlite src/server.js",
    "dev": "node --no-warnings --experimental-sqlite --watch src/server.js",
    "init-db": "node --no-warnings --experimental-sqlite src/database/init.js",
    "seed": "node --no-warnings --experimental-sqlite src/database/seed.js",
    "inspect-db": "node --no-warnings --experimental-sqlite src/database/inspect.js",
    "test": "node --no-warnings --experimental-sqlite --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
